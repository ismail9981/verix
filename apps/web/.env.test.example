# Disposable PostgreSQL integration tests only.
# Copy values into an ignored .env.test.local or export them in your shell.
# Never point these values at hosted Supabase or another remote database.

NODE_ENV="test"
VERIX_TEST_DATABASE="1"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/verix_test"

# Optional comma-separated host allowlist for an explicitly disposable CI
# service, for example: TEST_DATABASE_ALLOWED_HOSTS="postgres,ci-postgres"
TEST_DATABASE_ALLOWED_HOSTS=""

# Repository-local Supabase uses this exact additional contract instead:
# VERIX_LOCAL_SUPABASE="verix"
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
