    "@supabase/supabase-js": "^2.110.2",
    "dotenv": "^16.0.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "next": "16.2.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
