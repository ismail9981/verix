# Copy to `.env` and fill in real values. Do NOT commit `.env`.
# These are validated at server startup by src/server/env.ts.

# --- Database ---
# Postgres connection string. In production use the Supabase connection
# pooler URL (Project Settings → Database → Connection pooling).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# --- Supabase ---
# Project Settings → API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
