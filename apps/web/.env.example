# Copy to `.env` and fill in real values. Do NOT commit `.env`.
# These are validated at server startup by src/server/env.ts.

# --- Database ---
# Postgres connection string. In production use the Supabase connection
# pooler URL (Project Settings → Database → Connection pooling).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# --- Supabase (server-only secrets) ---
# Project Settings → API. The service-role key MUST never reach the browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Supabase (public, exposed to the browser for SSR auth) ---
# Safe to expose: the anon key is protected by Row Level Security. Used by the
# @supabase/ssr clients (browser + middleware + server). Mirror the values above.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Random server-only HMAC key (minimum 32 characters). Never expose publicly.
ACTIVE_WORKSPACE_COOKIE_SECRET="replace-with-at-least-32-random-characters"

# --- Host routing (proxy.ts, Sprint 7.3) ---
# Kill switch: set "false" to fully disable host-based rewriting.
ENABLE_HOST_ROUTING="true"
# Extra application/dashboard hostnames, comma-separated. localhost and the
# app domain (+ its "app." subdomain) are always included — see
# src/server/hosting/config.ts. Usually only needed in production, e.g.:
# APP_HOST="app.verix.app"
APP_HOST=""
# Only honor x-forwarded-host/forwarded when explicitly trusted (e.g. behind
# an operator-controlled reverse proxy). Leave "false" on Vercel — the Host
# header it forwards is already the real per-domain hostname.
TRUST_X_FORWARDED_HOST="false"

# --- Public lead forms (Sprint 9) ---
# Salts the one-way hash stored in `leads.ip_hash` (never the raw IP). Has a
# dev-only default; set a real random value in production.
LEAD_IP_HASH_SALT=""
